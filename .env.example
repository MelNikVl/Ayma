# --- База данных ---
DATABASE_URL="postgresql://aimarket:aimarket@localhost:5432/aimarket?schema=public"

# --- Приложение ---
# Публичный URL (без слэша в конце). Telegram Login Widget работает только на домене,
# привязанном к боту через @BotFather → /setdomain
APP_URL="http://localhost:3000"

# Секрет для подписи сессий (минимум 32 символа): openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Telegram ---
# Токен бота от @BotFather (нужен для проверки подписи логина и уведомлений фаундерам)
TELEGRAM_BOT_TOKEN=""
# Username бота БЕЗ @ (для виджета входа)
TELEGRAM_BOT_USERNAME=""

# Telegram ID администраторов через запятую — получат роль ADMIN при входе
ADMIN_TELEGRAM_IDS=""

# --- GitHub ---
# Необязательно, но без токена лимит API — 60 запросов/час
GITHUB_TOKEN=""

# --- Модерация ---
# true — новые стартапы публикуются сразу, без модерации
AUTO_APPROVE="false"

# --- Разработка ---
# true — на странице входа появится кнопка «Dev-вход» (НИКОГДА не включайте в проде)
ENABLE_DEV_LOGIN="false"
# true — разрешить dev-вход в production-сборке (только для локального превью в Docker!)
DEV_LOGIN_ALLOW_PRODUCTION="false"

# Секрет для /api/cron/github (обновление звёзд по расписанию)
CRON_SECRET=""
