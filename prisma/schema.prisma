// AI Marketplace — схема БД
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(cuid())
  telegramId  BigInt? @unique // вход через Telegram (необязателен при входе через GitHub)
  githubId    Int?    @unique // вход через GitHub
  githubLogin String?
  username    String?
  firstName   String?
  avatarUrl   String?
  role        Role    @default(FOUNDER)

  // Профиль разработчика
  bio          String?  @db.VarChar(300)
  skills       String[]
  contactUrl   String? // Telegram, LinkedIn, сайт
  linkedinUrl  String?
  resumeUrl    String? // загруженный PDF (/uploads/…)
  resumeName   String?  @db.VarChar(120) // исходное имя файла
  openToCollab Boolean  @default(false)
  score        Int      @default(0) // рейтинг разработчика 0–100
  scoreData    Json?

  startups        Startup[]
  preOrders       PreOrder[]
  memberships     StartupMember[]
  claims          ClaimRequest[]
  votes           Vote[]
  collabsSent     CollabRequest[]  @relation("CollabFrom")
  collabsReceived CollabRequest[]  @relation("CollabToUser")
  createdAt       DateTime         @default(now())
  cryptoDonations CryptoDonation[]
  company         String?          @db.VarChar(80) // для заказчиков
  jobs            Job[]            @relation("JobAuthor")
  jobResponses    JobResponse[]
}

model Startup {
  id        String @id @default(cuid())
  slug      String @unique
  founderId String
  founder   User   @relation(fields: [founderId], references: [id])

  name      String
  shortDesc String  @db.VarChar(150)
  fullDesc  String  @db.Text
  logoUrl   String?
  coverUrl  String?

  githubUrl        String?
  githubStars      Int       @default(0)
  githubLastCommit DateTime?
  demoUrl          String?
  websiteUrl       String?

  preOrderEnabled Boolean @default(false)
  preOrderGoal    Int     @default(0) // цель сбора в ₸ (0 — без цели)
  preOrderPrice   Int     @default(0) // цена одной единицы услуги в ₸
  preOrderDesc    String? @db.Text // что именно получает спонсор
  paymentUrl      String? // ссылка на оплату фаундера (Kaspi Pay, Stripe link и т.п.)

  // Данные репозитория (README, авторы, коммиты, структура) — для импортированных проектов
  readme   String? @db.Text
  repoMeta Json?

  status      Status          @default(PENDING)
  preOrders   PreOrder[]
  tags        Tag[]
  members     StartupMember[]
  claims      ClaimRequest[]
  votes       Vote[]
  collabsFrom CollabRequest[] @relation("CollabFromStartup")
  collabsTo   CollabRequest[] @relation("CollabToStartup")

  viewsCount Int @default(0)

  // Рейтинг
  score      Int   @default(0) // AYMA Score 0–100
  scoreData  Json? // разбивка по составляющим
  votesCount Int   @default(0)

  // API и коллаборации
  apiStatus    ApiStatus @default(NONE)
  apiTypes     String[] // REST, GraphQL, gRPC, WebSocket, SDK, Webhooks, MCP
  apiDocsUrl   String?
  openToCollab Boolean   @default(false)
  collabNote   String?   @db.VarChar(500)

  // Бизнес-информация (необязательно)
  roadmap         Json? // [{ title, period, status: done|doing|planned }]
  fundingNeed     Int? // сколько вложений нужно, ₸
  fundingNeedDesc String? @db.Text // на что
  advantages      String? @db.Text // чем лучше конкурентов
  competitors     String? @db.VarChar(500)
  implPrice       Int? // цена внедрения, ₸
  implDays        Int? // срок внедрения, дней

  // Оформление страницы проекта
  pageTheme  String  @default("default")
  pageAccent String?
  pageFont   String  @default("sans")
  pageLayout String  @default("classic")

  // Кошелёк команды (EVM) для спонсорства в USDT через MetaMask
  walletAddress   String?
  cryptoDonations CryptoDonation[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobResponses JobResponse[]

  @@index([status])
  @@index([slug])
  @@index([score])
}

/// Голос «нравится» за проект (один пользователь — один голос)
model Vote {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, startupId])
  @@index([startupId, createdAt])
}

/// Предложение коллаборации: от разработчика (и, по желанию, от его проекта) проекту или разработчику
model CollabRequest {
  id            String       @id @default(cuid())
  fromUserId    String
  fromUser      User         @relation("CollabFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromStartupId String?
  fromStartup   Startup?     @relation("CollabFromStartup", fields: [fromStartupId], references: [id], onDelete: SetNull)
  toStartupId   String?
  toStartup     Startup?     @relation("CollabToStartup", fields: [toStartupId], references: [id], onDelete: Cascade)
  toUserId      String?
  toUser        User?        @relation("CollabToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  kind          String       @default("other") // integration, api, team, pilot, other
  message       String       @db.VarChar(1000)
  contact       String?      @db.VarChar(200)
  status        CollabStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  @@index([toStartupId, status])
  @@index([toUserId, status])
  @@index([fromUserId])
}

model PreOrder {
  id        String  @id @default(cuid())
  startupId String
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sponsorId String
  sponsor   User    @relation(fields: [sponsorId], references: [id])

  amount      Int // итоговая сумма в ₸ (preOrderPrice × quantity)
  quantity    Int           @default(1)
  status      PaymentStatus @default(PENDING)
  paymentLink String?
  contactInfo String? // Telegram/Email спонсора

  createdAt DateTime @default(now())

  @@index([startupId, status])
  @@index([sponsorId])
}

/// Участник команды проекта (до 3 человек). Участники управляют карточкой и видят предзаказы.
model StartupMember {
  id        String     @id @default(cuid())
  startupId String
  startup   Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  @@unique([startupId, userId])
  @@index([userId])
}

/// Заявка «это мой проект», если автоматическая проверка по GitHub не подтвердила участие.
model ClaimRequest {
  id        String      @id @default(cuid())
  startupId String
  startup   Startup     @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?     @db.VarChar(500)
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@unique([startupId, userId])
  @@index([status])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  color    String    @default("#0066FF")
  startups Startup[]
}

enum Role {
  FOUNDER
  SPONSOR
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum ApiStatus {
  NONE
  PLANNED
  BETA
  PUBLIC
}

enum CollabStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

/// Просмотр страницы (собственная аналитика без cookies: посетитель = суточный хеш IP+UA)
model PageView {
  id          String   @id @default(cuid())
  path        String   @db.VarChar(300)
  referrer    String?  @db.VarChar(200) // домен источника
  utmSource   String?  @db.VarChar(100)
  utmMedium   String?  @db.VarChar(100)
  utmCampaign String?  @db.VarChar(100)
  visitor     String   @db.VarChar(32)
  locale      String?  @db.VarChar(5)
  device      String?  @db.VarChar(10) // mobile | desktop
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

enum CryptoStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// Спонсорство в USDT напрямую на кошелёк команды (некастодиально: AYMA средства не хранит)
model CryptoDonation {
  id          String       @id @default(cuid())
  startupId   String
  startup     Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  chainId     Int
  txHash      String       @unique
  fromAddress String?
  toAddress   String
  amountRaw   String?
  amountCents Int          @default(0) // сумма в центах USDT
  message     String?
  status      CryptoStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?

  @@index([startupId, status])
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  DONE
  CLOSED
}

enum JobResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Задача от заказчика на бирже: «нужна вот такая фича»
model Job {
  id             String        @id @default(cuid())
  authorId       String
  author         User          @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title          String        @db.VarChar(120)
  description    String
  categories     String[]
  company        String?       @db.VarChar(80)
  budgetMin      Int? // ₸, null — договорная
  budgetMax      Int?
  deadlineDays   Int?
  contact        String?       @db.VarChar(200) // видят только выбранные исполнители
  status         JobStatus     @default(OPEN)
  hidden         Boolean       @default(false) // скрыто модератором
  responsesCount Int           @default(0)
  viewsCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  responses      JobResponse[]

  @@index([status, createdAt])
  @@index([authorId])
}

/// Отклик разработчика на задачу
model JobResponse {
  id        String            @id @default(cuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String? // отклик от имени своего проекта
  startup   Startup?          @relation(fields: [startupId], references: [id], onDelete: SetNull)
  message   String
  price     Int? // ₸
  days      Int?
  status    JobResponseStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}
